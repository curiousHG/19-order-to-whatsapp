# Development environment. Copy to .env and fill in.
#
# .env holds DEVELOPMENT values only. Production values live in Railway's
# service variables and are never stored here — `dev.py db-sync` reads the
# production credentials from the Railway CLI at call time.

# development | production. Defaults to production when unset, so a missing
# value never exposes debug pages. DEBUG is derived from this.
ENVIRONMENT=development

# Local Postgres. Create the database once with:
#   createdb 19shopdb
# then populate it from production with:
#   uv run dev.py db-sync
DB_NAME=19shopdb
DB_USER=your-macos-username
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY=any-random-string-for-local-use

# Shared with production — uploads from local dev land in the same
# Cloudinary account. Use a separate account if that matters to you.
CLOUDINARY_URL=cloudinary://key:secret@cloud-name

# Only needed to exercise Google sign-in locally.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
